# ClauseKit backend configuration.
# Copy to .env and fill in your key. .env is gitignored — never commit it.

# Required: your Anthropic API key (lives only on the backend, never in the client).
ANTHROPIC_API_KEY=

# Optional: model id (swappable). Defaults to Haiku 4.5 (cheapest tier).
# Use claude-sonnet-4-6 for stronger reasoning, or claude-opus-4-8 for the best.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: port for the backend API. Distinct from the add-in (3000) and playground (3001).
PORT=4000
