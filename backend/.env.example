# ClauseKit backend configuration.
# Copy to .env and fill in your key. .env is gitignored — never commit it.

# Required: your Anthropic API key (lives only on the backend, never in the client).
ANTHROPIC_API_KEY=

# Optional: MongoDB connection string (e.g. a free Atlas M0 cluster). Powers the
# restart-surviving daily spend counter (usage_daily) and per-call usage records
# (sessions) — metadata only, never contract text. Unset or unreachable → the
# backend logs it and keeps serving with in-memory state only.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# Optional: database name within the cluster (default: clausekit).
# MONGODB_DB=clausekit

# Optional: model id (swappable). Defaults to Haiku 4.5 to keep token costs low.
# The server validates edits (originalText must be a verbatim substring) and
# drops any that fail, so a cheaper model can only offer fewer redlines, never a
# broken one. Use claude-sonnet-4-6 for stronger verbatim reproduction if needed.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: model for the Negotiation Simulator (/api/negotiate). Defaults to
# Sonnet 4.6 — the sharpest-reasoning task (multi-perspective role-play + verbatim
# anchors). Bump to claude-opus-4-8 if the analysis quality needs it.
# NEGOTIATE_MODEL=claude-sonnet-4-6
NEGOTIATE_MODEL=claude-haiku-4-5

# Optional: port for the backend API. Distinct from the add-in (3000) and
# playground (3001). Deploy platforms (Cloud Run etc.) inject their own PORT.
PORT=4000

# ── Production hardening (all optional; localhost defaults apply in dev) ──

# CORS allowlist — comma-separated origins allowed to call the API. In prod set
# this to your deployed frontend/playground origin(s). Unset → local dev origins
# (vite 5173/5174, HTTPS add-in + playground 3000/3001).
# ALLOWED_ORIGINS=https://clausekit.example.com,https://play.clausekit.example.com

# Per-IP rate limits. /api/ask is generous; /api/negotiate is tight (each run is
# ~4k+ tokens) with a low daily cap too.
# ASK_RATE_PER_MIN=30
# NEGOTIATE_RATE_PER_MIN=5
# NEGOTIATE_RATE_PER_DAY=25

# App-level daily spend backstop: refuse new LLM requests once cumulative token
# usage crosses this ceiling (resets each UTC day). Set a hard cap in the
# Anthropic Console too — that's the ultimate backstop.
# DAILY_TOKEN_CEILING=25000
