{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "target": "ES2020",
    "jsx": "react-jsx",
    "types": [
      "office-js",
      "webpack-env"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "webpack.config.js",
    "babel.config.json"
  ]
}