%%{init: {
  "fontFamily": "Arial, Helvetica, sans-serif",
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#f8f9fa",
    "primaryTextColor": "#111827",
    "primaryBorderColor": "#cbd5e1",
    "lineColor": "#9ca3af",
    "clusterBkg": "transparent",
    "clusterBorder": "#e5e7eb",
    "edgeLabelBackground": "#f3f4f6",
    "tertiaryTextColor": "#6b7280"
  },
  "flowchart": { "curve": "basis", "nodeSpacing": 45, "rankSpacing": 75, "padding": 14 }
}}%%
flowchart LR
    W("<b>Microsoft Word</b><br/><i>Office.js host</i>")

    subgraph vercel["VERCEL"]
        direction TB
        A("<b>Landing page</b><br/><i>frontend/</i>")
        B("<b>Playground + task pane</b><br/><i>microservices/word-addin/</i>")
    end

    subgraph gcr["GOOGLE CLOUD RUN"]
        C("<b>Backend API</b><br/><i>backend/ · Express + tRPC</i>")
    end

    subgraph ai["ANTHROPIC"]
        D("<b>Claude</b><br/><i>Haiku 4.5 · prompt caching</i>")
    end

    subgraph atlas["MONGODB ATLAS"]
        M[("<b>clausekit</b><br/><i>usage_daily · sessions</i>")]
    end

    A -->|Try the demo| B
    W -.->|loads task pane| B
    B ==>|"<b>tRPC</b> · ask / negotiate<br/><i>typed end-to-end by AppRouter</i>"| C
    C -->|Anthropic SDK| D
    C -->|"token spend counter · usage records"| M

    classDef app fill:#f8f9fa,stroke:#cbd5e1,stroke-width:1.5px,color:#111827
    classDef word fill:#eff6ff,stroke:#2b7cd3,stroke-width:1.5px,color:#1e3a8a
    classDef api fill:#fffbeb,stroke:#f59e0b,stroke-width:2px,color:#92400e
    classDef llm fill:#faf0ea,stroke:#cc785c,stroke-width:1.5px,color:#8a4b2f
    classDef data fill:#ecfdf5,stroke:#10b981,stroke-width:1.5px,color:#065f46

    class A,B app
    class W word
    class C api
    class D llm
    class M data

    style vercel fill:transparent,stroke:#e5e7eb,color:#6b7280
    style gcr fill:transparent,stroke:#e5e7eb,color:#6b7280
    style ai fill:transparent,stroke:#e5e7eb,color:#6b7280
    style atlas fill:transparent,stroke:#e5e7eb,color:#6b7280

    linkStyle 2 stroke:#f59e0b,stroke-width:2.5px
    linkStyle 3 stroke:#cc785c,stroke-width:1.5px
    linkStyle 4 stroke:#10b981,stroke-width:1.5px
