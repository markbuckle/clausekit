%%{init: {
  "fontFamily": "Arial, Helvetica, sans-serif",
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#0d0d12",
    "primaryTextColor": "#f5f5f6",
    "primaryBorderColor": "#3a3a44",
    "lineColor": "#565b66",
    "clusterBkg": "transparent",
    "clusterBorder": "#26262e",
    "edgeLabelBackground": "#101014",
    "tertiaryTextColor": "#9a9aa4"
  },
  "flowchart": { "curve": "basis", "nodeSpacing": 45, "rankSpacing": 75, "padding": 14 }
}}%%
flowchart LR
    W("<b>Microsoft Word</b><br/><i>Office.js host</i>")

    subgraph vercel["VERCEL"]
        direction TB
        A("<b>Landing page</b><br/><i>frontend/</i>")
        B("<b>Playground + task pane</b><br/><i>microservices/word-addin/</i>")
    end

    subgraph gcr["GOOGLE CLOUD RUN"]
        C("<b>Backend API</b><br/><i>backend/ · Express + tRPC</i>")
    end

    subgraph ai["ANTHROPIC"]
        D("<b>Claude</b><br/><i>Haiku 4.5 · prompt caching</i>")
    end

    subgraph atlas["MONGODB ATLAS"]
        M[("<b>clausekit</b><br/><i>usage_daily · sessions</i>")]
    end

    A -->|Try the demo| B
    W -.->|loads task pane| B
    B ==>|"<b>tRPC</b> · ask / negotiate<br/><i>typed end-to-end by AppRouter</i>"| C
    C -->|Anthropic SDK| D
    C -->|"$inc spend · session records"| M

    classDef app fill:#0d0d12,stroke:#3a3a44,stroke-width:1.5px,color:#f5f5f6
    classDef word fill:#0a1220,stroke:#2b7cd3,stroke-width:1.5px,color:#dbeafe
    classDef api fill:#16100a,stroke:#f59e0b,stroke-width:2px,color:#fde9c8
    classDef llm fill:#170e08,stroke:#cc785c,stroke-width:1.5px,color:#f5d9cc
    classDef data fill:#06130d,stroke:#10b981,stroke-width:1.5px,color:#d1fae5

    class A,B app
    class W word
    class C api
    class D llm
    class M data

    style vercel fill:transparent,stroke:#26262e,color:#9a9aa4
    style gcr fill:transparent,stroke:#26262e,color:#9a9aa4
    style ai fill:transparent,stroke:#26262e,color:#9a9aa4
    style atlas fill:transparent,stroke:#26262e,color:#9a9aa4

    linkStyle 2 stroke:#f59e0b,stroke-width:2.5px
    linkStyle 3 stroke:#cc785c,stroke-width:1.5px
    linkStyle 4 stroke:#10b981,stroke-width:1.5px
